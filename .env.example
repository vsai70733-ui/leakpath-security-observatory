# Full-stack Manus OAuth configuration
# Use the values from the Manus Webdev project that owns this app.
MANUS_PROJECT_ID=your_manus_project_id
MANUS_JWT_SECRET=replace_with_a_long_random_secret
MANUS_OAUTH_PORTAL_URL=https://manus.im
MANUS_OAUTH_API_URL=https://api.manus.im
# Set this to the deployed HTTPS origin, with no trailing slash.
PUBLIC_ORIGIN=https://your-service.onrender.com

# Optional persistence. Leave unset to use the in-memory demo store.
DATABASE_URL=
